#include <dt-bindings/zmk/matrix_transform.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &charybdis3m_layout;
    };

    default_transform: keymap_transform_0 {
	compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
			RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)                   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
			RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)                   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
			RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)                   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
			RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)                   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
				                RC(4,3) RC(4,2) RC(4,1)                   RC(4,7)  RC(4,8)
						        RC(4,5) RC(4,4)                   RC(4,10) 
        >;
    };

    /* Approximate key positions for ZMK Studio, in matrix-transform order:
     * four 12-key rows, then the 3+2 and 2+1 thumb rows. */
    charybdis3m_layout: charybdis3m_layout {
        compatible = "zmk,physical-layout";
        display-name = "Charybdis 3m";
        transform = <&default_transform>;
        keys  //                     w   h     x    y     rot   rx   ry
            = <&key_physical_attrs 100 100     0   30       0    0    0>
            , <&key_physical_attrs 100 100   100   30       0    0    0>
            , <&key_physical_attrs 100 100   200   10       0    0    0>
            , <&key_physical_attrs 100 100   300    0       0    0    0>
            , <&key_physical_attrs 100 100   400   10       0    0    0>
            , <&key_physical_attrs 100 100   500   20       0    0    0>
            , <&key_physical_attrs 100 100   900   20       0    0    0>
            , <&key_physical_attrs 100 100  1000   10       0    0    0>
            , <&key_physical_attrs 100 100  1100    0       0    0    0>
            , <&key_physical_attrs 100 100  1200   10       0    0    0>
            , <&key_physical_attrs 100 100  1300   30       0    0    0>
            , <&key_physical_attrs 100 100  1400   30       0    0    0>
            , <&key_physical_attrs 100 100     0  130       0    0    0>
            , <&key_physical_attrs 100 100   100  130       0    0    0>
            , <&key_physical_attrs 100 100   200  110       0    0    0>
            , <&key_physical_attrs 100 100   300  100       0    0    0>
            , <&key_physical_attrs 100 100   400  110       0    0    0>
            , <&key_physical_attrs 100 100   500  120       0    0    0>
            , <&key_physical_attrs 100 100   900  120       0    0    0>
            , <&key_physical_attrs 100 100  1000  110       0    0    0>
            , <&key_physical_attrs 100 100  1100  100       0    0    0>
            , <&key_physical_attrs 100 100  1200  110       0    0    0>
            , <&key_physical_attrs 100 100  1300  130       0    0    0>
            , <&key_physical_attrs 100 100  1400  130       0    0    0>
            , <&key_physical_attrs 100 100     0  230       0    0    0>
            , <&key_physical_attrs 100 100   100  230       0    0    0>
            , <&key_physical_attrs 100 100   200  210       0    0    0>
            , <&key_physical_attrs 100 100   300  200       0    0    0>
            , <&key_physical_attrs 100 100   400  210       0    0    0>
            , <&key_physical_attrs 100 100   500  220       0    0    0>
            , <&key_physical_attrs 100 100   900  220       0    0    0>
            , <&key_physical_attrs 100 100  1000  210       0    0    0>
            , <&key_physical_attrs 100 100  1100  200       0    0    0>
            , <&key_physical_attrs 100 100  1200  210       0    0    0>
            , <&key_physical_attrs 100 100  1300  230       0    0    0>
            , <&key_physical_attrs 100 100  1400  230       0    0    0>
            , <&key_physical_attrs 100 100     0  330       0    0    0>
            , <&key_physical_attrs 100 100   100  330       0    0    0>
            , <&key_physical_attrs 100 100   200  310       0    0    0>
            , <&key_physical_attrs 100 100   300  300       0    0    0>
            , <&key_physical_attrs 100 100   400  310       0    0    0>
            , <&key_physical_attrs 100 100   500  320       0    0    0>
            , <&key_physical_attrs 100 100   900  320       0    0    0>
            , <&key_physical_attrs 100 100  1000  310       0    0    0>
            , <&key_physical_attrs 100 100  1100  300       0    0    0>
            , <&key_physical_attrs 100 100  1200  310       0    0    0>
            , <&key_physical_attrs 100 100  1300  330       0    0    0>
            , <&key_physical_attrs 100 100  1400  330       0    0    0>
            , <&key_physical_attrs 100 100   330  430       0    0    0>
            , <&key_physical_attrs 100 100   440  440    1500  490  490>
            , <&key_physical_attrs 100 100   550  470    3000  600  520>
            , <&key_physical_attrs 100 100   810  450 (-1500)  860  500>
            , <&key_physical_attrs 100 100   920  430       0    0    0>
            , <&key_physical_attrs 100 100   420  550    1500  470  600>
            , <&key_physical_attrs 100 100   530  580    3000  580  630>
            , <&key_physical_attrs 100 100   860  560 (-1500)  910  610>
            ;
    };

    /* Trackball on the right half, proxied to the central over split.
     * Enabled only in the right and central overlays. */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
        };
    };

    /* Pulses P1.15 on the dongle (zmk-behavior-pushbutton); enabled only in
     * the central overlay so the keymap can reference &pb on every board. */
    behaviors {
        pb: pushbutton {
            compatible = "zmk,behavior-pushbutton";
            display-name = "Push Button";
            #binding-cells = <0>;
            gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
            press-duration-ms = <200>;
            status = "disabled";
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
        input-processors = <&zip_xy_scaler 1 2>;

        scroller {
            layers = <3>;
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>, <&zip_xy_scaler 1 16>, <&zip_xy_to_scroll_mapper>;
        };
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
		row-gpios
            	= <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            	, <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            	, <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
	        , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
	        , <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

